---
import Carousel from './Carousel.astro';
import TechIcon from './TechIcon.astro';
import { techIcons } from './icons';

interface Props {
	id: string;
	title: string;
	description: string;
	images: string[];
	stack: string[];
	githubUrl?: string;
	liveUrl?: string;
	labels: {
		close: string;
		stack: string;
		viewLive: string;
		viewCode: string;
	};
}

const { id, title, description, images, stack, githubUrl, liveUrl, labels } = Astro.props;
---

<dialog
	class="project-modal"
	id={`modal-${id}`}
	data-project-modal={id}
	aria-labelledby={`modal-${id}-title`}
	aria-describedby={`modal-${id}-desc`}
>
	<div class="project-modal__backdrop" aria-hidden="true"></div>
	<div class="project-modal__panel" role="document">
		<button class="project-modal__close" type="button" data-project-close aria-label={labels.close}>
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>

		<div class="project-modal__media">
			<Carousel images={images} alt={title} id={id} />
		</div>

		<div class="project-modal__content">
			<h2 class="project-modal__title" id={`modal-${id}-title`}>{title}</h2>
			<p class="project-modal__desc" id={`modal-${id}-desc`}>{description}</p>

			<div class="project-modal__stack">
				<p class="project-modal__stack-label">{labels.stack}</p>
				<ul class="tech-orbit" aria-label={labels.stack}>
					{
						stack.map((slug, idx) => {
							const meta = techIcons[slug];
							return (
								<li class="tech-orbit__chip" style={`--stagger-delay: ${idx * 60}ms`}>
									<TechIcon slug={slug} size={16} />
									<span>{meta?.label ?? slug}</span>
								</li>
							);
						})
					}
				</ul>
			</div>

			<div class="project-modal__actions">
				{
					liveUrl && (
						<a
							class="action-cmd action-cmd--primary"
							href={liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-magnetic
						>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
								<polyline points="15 3 21 3 21 9" />
								<line x1="10" y1="14" x2="21" y2="3" />
							</svg>
							<span>{labels.viewLive}</span>
						</a>
					)
				}
				{
					githubUrl && (
						<a
							class="action-cmd action-cmd--secondary"
							href={githubUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-magnetic
						>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
								<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.94c-3.2.7-3.88-1.54-3.88-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.8.55 4.57-1.52 7.86-5.83 7.86-10.91C23.5 5.65 18.35.5 12 .5z" />
							</svg>
							<span>{labels.viewCode}</span>
						</a>
					)
				}
			</div>
		</div>
	</div>
</dialog>

<style>
	.project-modal {
		max-width: none;
		max-height: none;
		width: 100vw;
		height: 100vh;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--text-color);
		overflow: hidden;
	}

	.project-modal::backdrop {
		background: transparent;
	}

	.project-modal[open] {
		display: grid;
		place-items: center;
	}

	.project-modal__backdrop {
		position: fixed;
		inset: 0;
		background:
			radial-gradient(circle at 30% 20%, rgba(var(--primary-color-rgb), 0.18), transparent 55%),
			radial-gradient(circle at 70% 80%, rgba(var(--secondary-color-rgb), 0.18), transparent 55%),
			rgba(10, 11, 20, 0.78);
		backdrop-filter: blur(24px) saturate(140%);
		-webkit-backdrop-filter: blur(24px) saturate(140%);
		opacity: 0;
		transition: opacity 0.35s var(--ease-premium);
	}

	.project-modal[open] .project-modal__backdrop {
		opacity: 1;
	}

	.project-modal__panel {
		position: relative;
		width: min(1080px, 94vw);
		max-height: 92vh;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 0;
		border-radius: 20px;
		overflow: hidden;
		background: color-mix(in srgb, var(--card-bg) 78%, transparent);
		border: 1px solid rgba(var(--primary-color-rgb), 0.35);
		box-shadow:
			0 30px 80px rgba(0, 0, 0, 0.55),
			0 0 0 1px rgba(var(--primary-color-rgb), 0.18),
			0 0 60px rgba(var(--primary-color-rgb), 0.18);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		transform: translateY(16px) scale(0.985);
		opacity: 0;
		transition:
			transform 0.4s var(--ease-premium),
			opacity 0.35s var(--ease-premium);
	}

	.project-modal[open] .project-modal__panel {
		transform: translateY(0) scale(1);
		opacity: 1;
	}

	.project-modal__close {
		position: absolute;
		top: 14px;
		right: 14px;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-color) 70%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		cursor: pointer;
		z-index: 3;
		transition:
			background 0.25s var(--ease-premium),
			border-color 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
	}

	.project-modal__close:hover {
		background: color-mix(in srgb, var(--card-bg) 80%, var(--primary-color));
		border-color: var(--primary-color);
		transform: rotate(90deg);
	}

	.project-modal__media {
		min-width: 0;
	}

	.project-modal__media :global(.carousel) {
		height: 100%;
		border-radius: 0;
		box-shadow: none;
	}

	.project-modal__media :global(.carousel__slide) {
		aspect-ratio: auto;
		height: 100%;
	}

	.project-modal__content {
		padding: 1.75rem 1.9rem 1.9rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		overflow-y: auto;
	}

	.project-modal__title {
		margin: 0;
		font-size: 1.8rem;
		line-height: 1.15;
		background: linear-gradient(135deg, #ffffff 25%, color-mix(in srgb, #ffffff 70%, var(--secondary-color)) 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.project-modal__desc {
		margin: 0;
		color: var(--text-color);
		font-size: 0.96rem;
		line-height: 1.7;
	}

	.project-modal__stack-label {
		margin: 0 0 0.55rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-color);
	}

	.tech-orbit {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tech-orbit__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		font-size: 0.82rem;
		background: color-mix(in srgb, var(--card-bg) 60%, transparent);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		opacity: 0;
		transform: translateY(6px);
	}

	.project-modal[open] .tech-orbit__chip {
		animation: chipIn 0.45s var(--ease-premium) forwards;
		animation-delay: var(--stagger-delay, 0ms);
	}

	@keyframes chipIn {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.project-modal__actions {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-top: 0.4rem;
	}

	.action-cmd {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.7rem 1.1rem;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		cursor: pointer;
		border: 1px solid transparent;
		transition:
			transform 0.25s var(--ease-premium),
			box-shadow 0.25s var(--ease-premium),
			border-color 0.25s var(--ease-premium),
			background 0.25s var(--ease-premium);
		will-change: transform;
	}

	.action-cmd--primary {
		background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
		color: #ffffff;
		box-shadow: 0 8px 24px rgba(var(--primary-color-rgb), 0.35);
	}

	.action-cmd--primary:hover {
		box-shadow: 0 12px 32px rgba(var(--primary-color-rgb), 0.5);
	}

	.action-cmd--secondary {
		background: color-mix(in srgb, var(--card-bg) 80%, transparent);
		color: var(--text-color);
		border-color: var(--border-color);
	}

	.action-cmd--secondary:hover {
		border-color: var(--primary-color);
		background: color-mix(in srgb, var(--card-bg) 70%, var(--primary-color));
	}

	@media (max-width: 880px) {
		.project-modal__panel {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
			max-height: 94vh;
			width: 96vw;
		}

		.project-modal__media :global(.carousel__slide) {
			aspect-ratio: 16 / 9;
			height: auto;
		}

		.project-modal__content {
			padding: 1.3rem 1.3rem 1.5rem;
		}

		.project-modal__title {
			font-size: 1.45rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-modal__backdrop,
		.project-modal__panel,
		.tech-orbit__chip,
		.action-cmd,
		.project-modal__close {
			transition: none;
			animation: none;
		}
		.project-modal[open] .tech-orbit__chip {
			opacity: 1;
			transform: none;
			animation: none;
		}
	}
</style>
