---
interface Props {
	images: string[];
	alt: string;
	id: string;
}

const { images, alt, id } = Astro.props;
---

<div class="carousel" data-carousel id={`carousel-${id}`}>
	<div
		class="carousel__viewport"
		data-carousel-viewport
		role="region"
		aria-roledescription="carousel"
		aria-label={alt}
	>
		<ul class="carousel__track" data-carousel-track>
			{
				images.map((src, idx) => (
					<li class="carousel__slide" aria-roledescription="slide" aria-label={`${idx + 1} / ${images.length}`}>
						<img src={src} alt={`${alt} — slide ${idx + 1}`} loading="lazy" decoding="async" />
					</li>
				))
			}
		</ul>
	</div>

	{
		images.length > 1 && (
			<>
				<button class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="Previous image">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 18 9 12 15 6" />
					</svg>
				</button>
				<button class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="Next image">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="9 18 15 12 9 6" />
					</svg>
				</button>
				<ol class="carousel__dots" data-carousel-dots role="tablist" aria-label="Image navigation">
					{images.map((_, idx) => (
						<li>
							<button
								class={`carousel__dot${idx === 0 ? ' is-active' : ''}`}
								data-carousel-dot={idx}
								aria-label={`Go to image ${idx + 1}`}
								aria-current={idx === 0 ? 'true' : undefined}
								type="button"
							/>
						</li>
					))}
				</ol>
			</>
		)
	}
</div>

<style>
	.carousel {
		position: relative;
		width: 100%;
		border-radius: 14px;
		overflow: hidden;
		background: var(--bg-color);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
	}

	.carousel__viewport {
		overflow: hidden;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		outline: none;
	}

	.carousel__track {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.carousel__track::-webkit-scrollbar {
		display: none;
	}

	.carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		aspect-ratio: 16 / 9;
		position: relative;
	}

	.carousel__slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.carousel__arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-color) 70%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		cursor: pointer;
		transition:
			background 0.25s var(--ease-premium),
			border-color 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
		z-index: 2;
	}

	.carousel__arrow:hover {
		background: color-mix(in srgb, var(--card-bg) 90%, var(--primary-color));
		border-color: var(--primary-color);
	}

	.carousel__arrow:active {
		transform: translateY(-50%) scale(0.94);
	}

	.carousel__arrow--prev {
		left: 12px;
	}

	.carousel__arrow--next {
		right: 12px;
	}

	.carousel__dots {
		position: absolute;
		bottom: 14px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 8px;
		list-style: none;
		margin: 0;
		padding: 6px 10px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-color) 60%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 2;
	}

	.carousel__dot {
		width: 8px;
		height: 8px;
		min-width: 8px;
		min-height: 8px;
		border-radius: 999px;
		border: 0;
		background: rgba(255, 255, 255, 0.35);
		padding: 0;
		cursor: pointer;
		transition:
			background 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
	}

	.carousel__dot.is-active {
		background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
		transform: scale(1.25);
	}

	@media (max-width: 640px) {
		.carousel__arrow {
			width: 38px;
			height: 38px;
		}
	}
</style>

<script>
	function initCarousel(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-carousel-track]');
		const slides = root.querySelectorAll<HTMLElement>('.carousel__slide');
		const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		const dots = root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]');
		if (!track || slides.length === 0) return;

		let current = 0;
		const setActive = (idx: number) => {
			current = Math.max(0, Math.min(idx, slides.length - 1));
			slides[current]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
			dots.forEach((d, i) => {
				d.classList.toggle('is-active', i === current);
				if (i === current) d.setAttribute('aria-current', 'true');
				else d.removeAttribute('aria-current');
			});
		};

		prev?.addEventListener('click', () => setActive(current - 1));
		next?.addEventListener('click', () => setActive(current + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => setActive(i)));

		// Update active dot on manual scroll (touch / trackpad)
		let scrollTimer: number | undefined;
		track.addEventListener(
			'scroll',
			() => {
				if (scrollTimer) window.clearTimeout(scrollTimer);
				scrollTimer = window.setTimeout(() => {
					const slideWidth = slides[0]?.getBoundingClientRect().width ?? 1;
					const idx = Math.round(track.scrollLeft / slideWidth);
					if (idx !== current) {
						current = idx;
						dots.forEach((d, i) => {
							d.classList.toggle('is-active', i === current);
							if (i === current) d.setAttribute('aria-current', 'true');
							else d.removeAttribute('aria-current');
						});
					}
				}, 100);
			},
			{ passive: true },
		);

		// Keyboard navigation: arrows / dots are native buttons, so Tab+Enter works.
		// Add Left/Right arrow handling on the carousel root for keyboard users with focus inside it.
		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				setActive(current - 1);
			} else if (e.key === 'ArrowRight') {
				e.preventDefault();
				setActive(current + 1);
			}
		});
	}

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
