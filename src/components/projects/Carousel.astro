---
interface Props {
	images: string[];
	alt: string;
	id: string;
}

const { images, alt, id } = Astro.props;
---

<div class="carousel" data-carousel id={`carousel-${id}`}>
	<div
		class="carousel__viewport"
		data-carousel-viewport
		role="region"
		aria-roledescription="carousel"
		aria-label={alt}
	>
		<ul class="carousel__track" data-carousel-track>
			{
				images.map((src, idx) => (
					<li class="carousel__slide" aria-roledescription="slide" aria-label={`${idx + 1} / ${images.length}`}>
						<img src={src} alt={`${alt} — slide ${idx + 1}`} loading="lazy" decoding="async" />
						<button class="carousel__fullscreen" data-fullscreen-btn aria-label="View fullscreen" type="button">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
							</svg>
						</button>
					</li>
				))
			}
		</ul>
	</div>

	{
		images.length > 1 && (
			<>
				<button class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="Previous image">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 18 9 12 15 6" />
					</svg>
				</button>
				<button class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="Next image">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="9 18 15 12 9 6" />
					</svg>
				</button>
				<ol class="carousel__dots" data-carousel-dots role="tablist" aria-label="Image navigation">
					{images.map((_, idx) => (
						<li>
							<button
								class={`carousel__dot${idx === 0 ? ' is-active' : ''}`}
								data-carousel-dot={idx}
								aria-label={`Go to image ${idx + 1}`}
								aria-current={idx === 0 ? 'true' : undefined}
								type="button"
							/>
						</li>
					))}
				</ol>
			</>
		)
	}
</div>

<dialog class="carousel-fullscreen" data-carousel-fullscreen={`carousel-${id}`}>
	<div class="carousel-fullscreen__overlay"></div>
	<div class="carousel-fullscreen__container">
		<button class="carousel-fullscreen__close" aria-label="Close fullscreen" type="button">
			<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="18" y1="6" x2="6" y2="18" />
				<line x1="6" y1="6" x2="18" y2="18" />
			</svg>
		</button>
		<img class="carousel-fullscreen__image" src="" alt="" />
	</div>
</dialog>

<style>
	.carousel {
		position: relative;
		width: 100%;
		border-radius: 14px;
		overflow: hidden;
		background: var(--bg-color);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
	}

	.carousel__viewport {
		overflow: hidden;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		outline: none;
	}

	.carousel__track {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.carousel__track::-webkit-scrollbar {
		display: none;
	}

	.carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		aspect-ratio: 16 / 9;
		position: relative;
	}

	.carousel__slide {
		position: relative;
	}

	.carousel__slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.carousel__fullscreen {
		position: absolute;
		top: 10px;
		right: 10px;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border-radius: 8px;
		background: color-mix(in srgb, var(--bg-color) 70%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		cursor: pointer;
		z-index: 2;
		transition:
			background 0.25s var(--ease-premium),
			border-color 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
		opacity: 0;
		transition: opacity 0.25s var(--ease-premium);
	}

	.carousel__slide:hover .carousel__fullscreen {
		opacity: 1;
	}

	.carousel__fullscreen:hover {
		background: color-mix(in srgb, var(--card-bg) 90%, var(--primary-color));
		border-color: var(--primary-color);
	}

	.carousel__fullscreen:active {
		transform: scale(0.94);
	}

	.carousel__arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-color) 70%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		cursor: pointer;
		transition:
			background 0.25s var(--ease-premium),
			border-color 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
		z-index: 2;
	}

	.carousel__arrow:hover {
		background: color-mix(in srgb, var(--card-bg) 90%, var(--primary-color));
		border-color: var(--primary-color);
	}

	.carousel__arrow:active {
		transform: translateY(-50%) scale(0.94);
	}

	.carousel__arrow--prev {
		left: 12px;
	}

	.carousel__arrow--next {
		right: 12px;
	}

	.carousel__dots {
		position: absolute;
		bottom: 14px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 8px;
		list-style: none;
		margin: 0;
		padding: 6px 10px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-color) 60%, transparent);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		z-index: 2;
	}

	.carousel__dot {
		width: 8px;
		height: 8px;
		min-width: 8px;
		min-height: 8px;
		border-radius: 999px;
		border: 0;
		background: rgba(255, 255, 255, 0.35);
		padding: 0;
		cursor: pointer;
		transition:
			background 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
	}

	.carousel__dot.is-active {
		background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
		transform: scale(1.25);
	}

	.carousel-fullscreen {
		max-width: none;
		max-height: none;
		width: 100vw;
		height: 100vh;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: hidden;
	}

	.carousel-fullscreen::backdrop {
		background: transparent;
	}

	.carousel-fullscreen[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.carousel-fullscreen__overlay {
		position: fixed;
		inset: 0;
		background: rgba(10, 11, 20, 0.95);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		z-index: -1;
	}

	.carousel-fullscreen__container {
		position: relative;
		width: min(95vw, 90vh);
		height: min(95vh, 90vw * 9 / 16);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.carousel-fullscreen__image {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
		border-radius: 12px;
	}

	.carousel-fullscreen__close {
		position: absolute;
		top: 20px;
		right: 20px;
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg-color) 70%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		cursor: pointer;
		z-index: 10;
		transition:
			background 0.25s var(--ease-premium),
			border-color 0.25s var(--ease-premium),
			transform 0.25s var(--ease-premium);
	}

	.carousel-fullscreen__close:hover {
		background: color-mix(in srgb, var(--card-bg) 80%, var(--primary-color));
		border-color: var(--primary-color);
		transform: rotate(90deg);
	}

	@media (max-width: 640px) {
		.carousel__arrow {
			width: 38px;
			height: 38px;
		}

		.carousel__fullscreen {
			width: 36px;
			height: 36px;
			top: 8px;
			right: 8px;
		}

		.carousel-fullscreen__close {
			width: 44px;
			height: 44px;
			top: 12px;
			right: 12px;
		}
	}
</style>

<script>
	function initCarousel(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-carousel-track]');
		const slides = root.querySelectorAll<HTMLElement>('.carousel__slide');
		const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		const dots = root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]');
		if (!track || slides.length === 0) return;

		let current = 0;
		const setActive = (idx: number) => {
			current = Math.max(0, Math.min(idx, slides.length - 1));
			slides[current]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
			dots.forEach((d, i) => {
				d.classList.toggle('is-active', i === current);
				if (i === current) d.setAttribute('aria-current', 'true');
				else d.removeAttribute('aria-current');
			});
		};

		prev?.addEventListener('click', () => setActive(current - 1));
		next?.addEventListener('click', () => setActive(current + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => setActive(i)));

		// Handle fullscreen image viewing
		const fullscreenBtns = root.querySelectorAll<HTMLButtonElement>('[data-fullscreen-btn]');
		const carouselId = root.getAttribute('id');
		const dialog = document.querySelector<HTMLDialogElement>(`dialog[data-carousel-fullscreen="${carouselId}"]`);
		const fullscreenImg = dialog?.querySelector<HTMLImageElement>('.carousel-fullscreen__image');
		const closeBtn = dialog?.querySelector<HTMLButtonElement>('.carousel-fullscreen__close');

		fullscreenBtns.forEach((btn, idx) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				if (!dialog || !fullscreenImg) return;
				const slide = slides[idx];
				const img = slide?.querySelector<HTMLImageElement>('img');
				if (img) {
					fullscreenImg.src = img.src;
					fullscreenImg.alt = img.alt;
					dialog.showModal();
					document.body.style.overflow = 'hidden';
				}
			});
		});

		closeBtn?.addEventListener('click', () => {
			dialog?.close();
			document.body.style.overflow = '';
		});

		dialog?.addEventListener('cancel', () => {
			document.body.style.overflow = '';
		});

		dialog?.addEventListener('click', (e) => {
			if (e.target === dialog) {
				dialog.close();
				document.body.style.overflow = '';
			}
		});

		// Update active dot on manual scroll (touch / trackpad)
		let scrollTimer: number | undefined;
		track.addEventListener(
			'scroll',
			() => {
				if (scrollTimer) window.clearTimeout(scrollTimer);
				scrollTimer = window.setTimeout(() => {
					const slideWidth = slides[0]?.getBoundingClientRect().width ?? 1;
					const idx = Math.round(track.scrollLeft / slideWidth);
					if (idx !== current) {
						current = idx;
						dots.forEach((d, i) => {
							d.classList.toggle('is-active', i === current);
							if (i === current) d.setAttribute('aria-current', 'true');
							else d.removeAttribute('aria-current');
						});
					}
				}, 100);
			},
			{ passive: true },
		);

		// Keyboard navigation: arrows / dots are native buttons, so Tab+Enter works.
		// Add Left/Right arrow handling on the carousel root for keyboard users with focus inside it.
		root.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				setActive(current - 1);
			} else if (e.key === 'ArrowRight') {
				e.preventDefault();
				setActive(current + 1);
			}
		});
	}

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
