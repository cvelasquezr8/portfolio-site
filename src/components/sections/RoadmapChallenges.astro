---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { languagesList } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

const currentLang = (Astro.currentLocale ?? 'en') as keyof typeof languagesList;
const translations = useTranslations(currentLang);
const roadmapLinks = (await getCollection('roadmap')).sort(
	(a, b) => a.data.order - b.data.order,
);
const pathPage = (globalThis as any).BASE_URL;
---

<section id="challenges" class="py-20 px-4 section-fade">
	<div class="container mx-auto">
		<SectionHeader
			eyebrow={translations('roadmap.subtitle')}
			title={translations('roadmap.title')}
		/>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{
				roadmapLinks.map((link) => (
					<Card
						description={link.data.description[currentLang]}
						tags={link.data.tags ?? []}
						className="h-full"
					>
						<span slot="icon" class="text-2xl flex items-center justify-center w-full h-full">
							{link.data.icon.image}
						</span>
						<div slot="title">
							<a
								href={link.data.href}
								target="_blank"
								rel="noopener noreferrer"
								class="text-xl font-semibold text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center gap-1"
							>
								{link.data.name[currentLang]}
							</a>
							<div class="mt-1">
								<span
									class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${link.data.status === 'completed' ? 'bg-green-500/15 text-green-400 border border-green-500/30' : 'bg-yellow-500/15 text-yellow-400 border border-yellow-500/30'}`}
								>
									{link.data.status === 'completed' ? '✓ Completed' : '⟳ In Progress'}
								</span>
							</div>
						</div>
						{link.data.href && (
							<div slot="actions">
								<Button href={link.data.href} target="_blank">
									<span>{translations('project.view_code')}</span>
									<img
										src={`${pathPage}images/github.svg`}
										alt=""
										aria-hidden="true"
										class="w-5 h-5"
										loading="lazy"
									/>
								</Button>
							</div>
						)}
					</Card>
				))
			}
		</div>
	</div>
</section>
