---
import { getCollection } from 'astro:content';
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { languagesList } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

const currentLang = (Astro.currentLocale ?? 'en') as keyof typeof languagesList;
const translations = useTranslations(currentLang);

const workExperience = (await getCollection('workExperience')).sort(
	(a, b) => a.data.order - b.data.order,
);
---
<section id="experience" class="py-20 px-4 section-fade">
  <div class="container mx-auto">
    <SectionHeader
      eyebrow={translations('experience.subtitle')}
      title={translations('experience.title')}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        workExperience.map((entry) => (
          <Card
            description={entry.data.description[currentLang]}
            summary={entry.data.summary[currentLang]}
            tags={entry.data.techs}
            className="h-full"
          >
            <svg
              slot="icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              aria-label={`${entry.data.company} — company building icon`}
              role="img"
            >
              {/* Roof / antenna */}
              <line x1="12" y1="3" x2="12" y2="1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              {/* Building outline */}
              <rect x="5" y="3" width="14" height="18" rx="1.2" stroke="currentColor" stroke-width="1.6"/>
              {/* Door */}
              <rect x="10.4" y="16" width="3.2" height="5" rx="0.3" stroke="currentColor" stroke-width="1.3"/>
              {/* Windows row 1 */}
              <rect x="7.3" y="5.8" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              <rect x="10.8" y="5.8" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              <rect x="14.3" y="5.8" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              {/* Windows row 2 */}
              <rect x="7.3" y="9.2" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              <rect x="10.8" y="9.2" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              <rect x="14.3" y="9.2" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              {/* Windows row 3 — frames the door */}
              <rect x="7.3" y="12.6" width="2.4" height="2" rx="0.3" fill="currentColor"/>
              <rect x="14.3" y="12.6" width="2.4" height="2" rx="0.3" fill="currentColor"/>
            </svg>

            <div slot="title">
              <p class="text-xs uppercase tracking-wider text-accent-color mb-1">{entry.data.period[currentLang]}</p>
              <h3 class="text-xl font-semibold mb-1 text-blue-400">{entry.data.role[currentLang]}</h3>
              <p class="text-sm text-gray-300">{entry.data.company}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  /* Override the default card-icon-wrapper sizing for company glyph (circular, matches Technologies). */
  #experience .card-icon-wrapper {
    width: 44px;
    height: 44px;
  }

  #experience .card-icon {
    width: 22px;
    height: 22px;
    color: #ffffff;
  }
</style>
