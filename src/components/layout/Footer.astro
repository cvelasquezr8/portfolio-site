---
import { getCollection } from 'astro:content';
import { languagesList, useTranslations } from '../../i18n';

const pathPage = (globalThis as any).BASE_URL;
const currentLang = (Astro.currentLocale ?? 'en') as keyof typeof languagesList;
const translations = useTranslations(currentLang);

const navigationLinks = (await getCollection('navigation'))
	.map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);

const certificationsLinks = (await getCollection('certifications'))
	.map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);

const socialLinks = (await getCollection('socialLinks'))
	.map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);

const workExperience = (await getCollection('workExperience'))
	.map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);

const featuredProjects = (await getCollection('projects'))
	.filter((entry) => entry.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

type FooterItem = {
	label: string;
	href?: string;
	pdfUrl?: string;
	isTargetBlank?: boolean;
	openProjectId?: string;
};

const navigationItems: FooterItem[] = navigationLinks.map((link) => ({
	label: link.name[currentLang],
	href: link.href,
}));

const experienceItems: FooterItem[] = workExperience.map((entry) => ({
	label: entry.name,
	href: entry.href,
}));

const projectItems: FooterItem[] = featuredProjects.map((entry) => ({
	label: entry.data.title[currentLang],
	openProjectId: entry.id,
}));

const certificateItems: FooterItem[] = certificationsLinks.map((cert) => ({
	label: cert.name[currentLang],
	pdfUrl: `${pathPage}${cert.pdfPath}`,
}));

const navigation: { title: string; elements: FooterItem[] }[] = [
	{ title: translations('footer.navigation.title'), elements: navigationItems },
	{ title: translations('footer.experience.title'), elements: experienceItems },
	{ title: translations('footer.project.title'), elements: projectItems },
	{ title: translations('footer.certificate.title'), elements: certificateItems },
];
---

<!-- Footer -->
<footer class="py-4 bg-gray-900/50 border-t border-blue-500/20 section-fade">
	<div class="container mx-auto px-4">
		<!-- Logo and Social Links -->
		<div
			class="flex flex-col md:flex-row items-center justify-between mb-8"
		>
			<div class="flex items-center gap-4 mb-6 md:mb-0">
				<div
					class="w-12 h-12 rounded-lg bg-gradient-to-r from-blue-600 to-purple-600 flex items-center justify-center text-white text-2xl"
				>
					🚀
				</div>
				<span class="gradient-text text-xl font-bold"
					>Carlos Velasquez</span
				>
			</div>
			<div class="flex gap-4">
				{
					socialLinks.map((link) => (
						<a
							href={link.url}
							class="p-2 rounded-lg bg-gray-800/50 hover:bg-blue-500/20 transition-colors"
							title={link.title}
							target="_blank"
							rel="noopener noreferrer"
						>
							<img
								src={`${pathPage}images/${link.icon}`}
								alt={link.title}
								class="w-6 h-6"
								loading="lazy"
							/>
						</a>
					))
				}
			</div>
		</div>

		<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 mb-12">
			{
				navigation.map((section) => (
					<div>
						<h3 class="text-blue-500">{section.title}</h3>
						<ul class="space-y-2">
							{section.elements.map((element) => (
								<li>
									{element.pdfUrl ? (
										<button
											onclick={`showPDFViewer('${element.pdfUrl}')`}
											class="text-gray-400 hover:text-blue-500 transition-colors text-left"
										>
											{element.label}
										</button>
									) : element.openProjectId ? (
										<button
											data-project-open={element.openProjectId}
											class="text-gray-400 hover:text-blue-500 transition-colors text-left"
										>
											{element.label}
										</button>
									) : (
										<a
											href={element.href}
											class="text-gray-400 hover:text-blue-500 transition-colors"
											target={element.isTargetBlank ? '_blank' : '_self'}
											rel={element.isTargetBlank ? 'noopener noreferrer' : undefined}
										>
											{element.label}
										</a>
									)}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<!-- Copyright -->
		<div class="text-center text-gray-400 pt-2 border-t border-blue-500/20">
			<p>
				© {new Date().getFullYear()} Carlos Velasquez. {
					translations('footer.rights')
				}
			</p>
			<p class="mt-2 text-sm">{translations('footer.crafted')}</p>
		</div>
	</div>
</footer>

<script>
	(window as any).showPDFViewer = function (pdfUrl: string) {
		const modal = document.querySelector('.pdf-viewer-modal');
		const iframe = modal?.querySelector('iframe');

		if (modal && iframe && pdfUrl) {
			iframe.src = pdfUrl;
			modal.classList.remove('hidden');
			document.body.style.overflow = 'hidden';
		}
	};
</script>
